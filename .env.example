# Copy to .env.local and adjust. Never commit real secrets.

# ---- Server-only (never exposed to the browser) ----
# demo = in-memory demo data (no backend needed)
# rest = call a real REST backend at API_BASE_URL
API_MODE=demo

# Required when API_MODE=rest
# API_BASE_URL=https://api.example.com/v1
# Optional service token sent as "Authorization: Bearer <token>" (server-side only).
# Used only for callers that already passed the auth check (src/lib/auth.ts).
# API_TOKEN=
#
# Auth is FAIL-CLOSED in rest mode: until you implement resolveSession() in
# src/lib/auth-provider.ts, every page shows "Sign-in required" and every mutation is refused.
# DANGEROUS escape hatch, only for apps already protected by a VPN / SSO gateway:
# AUTH_ALLOW_ANONYMOUS=false
# Request timeout in milliseconds
# API_TIMEOUT_MS=10000

# ---- Public (inlined into the browser bundle; never put secrets here) ----
NEXT_PUBLIC_APP_NAME=Atomic Admin
